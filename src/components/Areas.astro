---
import Icon from "./Icon.astro";
import Wave from "./Wave.astro";
import { services } from "../data/site";

const featured = services.filter((s) => s.featured);
---
<section class="areas">
  <div class="container areas__grid">
    {featured.map((s) => (
      <article class="area reveal">
        <div class={`area__icon area__icon--${s.color}`}><Icon name={s.icon} /></div>
        <h3>{s.name}</h3>
        <p>{s.summary}</p>
        <a href="#servicios" data-tab={s.id} class="link">Ver más →</a>
      </article>
    ))}
  </div>
  <Wave
    position="bottom"
    fill="var(--white)"
    height={100}
    d="M0,40 C240,100 420,0 720,40 C1000,80 1200,10 1440,50 L1440,100 L0,100 Z"
  />
</section>
